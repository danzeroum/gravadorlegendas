# =============================================================================
# gravadorlegendas — configuração multiplataforma (Windows + Fedora Linux)
# Copie para .env e ajuste conforme o ambiente. Nenhum valor aqui é um segredo.
# =============================================================================

# --- OCR ---------------------------------------------------------------------
# Caminho do executável do Tesseract. Em Linux o padrão é "tesseract" (PATH).
# Em Windows: "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_PATH=tesseract
OCR_LANGUAGE=eng

# --- Região de captura de tela ----------------------------------------------
REGION_TOP=0
REGION_LEFT=50
REGION_WIDTH=1820
REGION_HEIGHT=80

# --- Tradução ----------------------------------------------------------------
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-tc-big-en-pt

# --- LLM local (GGUF) --------------------------------------------------------
LOCAL_LLM_PATH=
LLM_THREADS=4
LLM_CTX=2048

# --- Ollama (Basic Auth opcional) --------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_USERNAME=
OLLAMA_PASSWORD=
OLLAMA_MODEL=mistral:latest

# --- Chaves de API (preencha apenas se for usar esses provedores) ------------
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Caminhos de dados (locais ao usuário; nunca versionados) ----------------
LOG_DIR=data/logs
RECORDING_DIR=data/recordings
WORDLIST_PATH=data/wordlists/pt_50k.txt

# --- Plataforma / backends ----------------------------------------------------
# auto | linux | windows
PLATFORM_BACKEND=auto
# auto | pipewire | wasapi
AUDIO_BACKEND=auto
# system (áudio do sistema) | microphone
AUDIO_SOURCE=system
# ID do dispositivo (PipeWire) ou índice numérico (WASAPI)
AUDIO_DEVICE_ID=
# auto | local_stt | windows_live | screen_ocr
CAPTION_SOURCE=auto
# auto | x11 | wayland_portal
SCREEN_CAPTURE_BACKEND=auto

# --- STT local (faster-whisper) ----------------------------------------------
# tiny | base | small | medium | large-v3
STT_MODEL=base
# auto | cpu | cuda
STT_DEVICE=auto
SAMPLE_RATE=16000
CHANNELS=1