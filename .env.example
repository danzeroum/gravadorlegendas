# ─── OCR ────────────────────────────────────────────────────────────────────
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: /usr/bin/tesseract
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng

# ─── Região de captura (pixels) ─────────────────────────────────────────────
REGION_TOP=0
REGION_LEFT=50
REGION_WIDTH=1820
REGION_HEIGHT=80

# ─── Tradução local ──────────────────────────────────────────────────────────
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-tc-big-en-pt

# ─── Ollama (servidor local ou remoto) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
# Deixe em branco se não usar autenticação Basic:
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

# ─── API Keys (opcional) ─────────────────────────────────────────────────────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ─── LLM local GGUF (opcional) ───────────────────────────────────────────────
LOCAL_LLM_PATH=tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LLM_THREADS=4
LLM_CTX=2048

# ─── Diretórios ──────────────────────────────────────────────────────────────
LOG_DIR=data/logs
RECORDING_DIR=data/recordings
WORDLIST_PATH=data/wordlists/pt_50k.txt
